# MT5 DEMO only: must be true, and the logged-in MT5 account must also be a DEMO account
JARVIS_MT5_DEMO=true
JARVIS_BROKER=mt5
# optional, max 5 symbols (use your broker's exact symbol names)
JARVIS_WATCHLIST=EURUSD,XAUUSD,US100,US30
# Optional veto-only filters (they can block a BUY, never create one)
JARVIS_USE_LAYA=false
JARVIS_LAYA_MIN_P=0.6
JARVIS_USE_CLAUDE=false
# ANTHROPIC_API_KEY=put_it_in_.env_yourself_never_in_chat
# Optional MT5 login by the script itself (DEMO account only). Fill these in your own .env, never in chat.
# JARVIS_MT5_LOGIN=
# JARVIS_MT5_PASSWORD=
# JARVIS_MT5_SERVER=
